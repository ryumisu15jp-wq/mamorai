{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      // input-core は workspace の src(main: ./src/index.ts) を直接参照して解決する。
      // pnpm の symlink でも解決されるが、明示 paths で型解決を確実にする（実装の再発明はしない）。
      "@mamorai/input-core": ["../../packages/input-core/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
