{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MAMOR-AI",
  "version": "0.1.0",
  "identifier": "jp.mamorai.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @mamorai/desktop dev",
    "beforeBuildCommand": "pnpm --filter @mamorai/desktop build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MAMOR-AI",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:3001",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "category": "Business",
    "shortDescription": "MAMOR-AI 警備日報デスクトップ (PC専用 / WebView2)"
  }
}