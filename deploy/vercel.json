{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/co/:path*", "destination": "/app/index.html" },
    { "source": "/s/:path*", "destination": "/app/index.html" },
    { "source": "/tradmin/:path*", "destination": "/app/index.html" }
  ],
  "headers": [
    {
      "source": "/app/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
